<Project Sdk="Microsoft.NET.Sdk">
  <!--
    One-click setup: finds the game, installs BepInEx 5 and the mod, and can uninstall.
    tools/package-release.ps1 (or .sh) fills payload/ and publishes a single Windows .exe.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Hotline-Setup</AssemblyName>
    <RootNamespace>Hotline.Installer</RootNamespace>
    <Version>0.5.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>..\branding\hotline.ico</ApplicationIcon>
    <!-- Registry calls are guarded by OperatingSystem.IsWindows(). -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hotline.Tests" />
  </ItemGroup>

  <!-- Community setup library: makes BepInEx start in this game (see third_party/ScamWYF.Setup.Core/NOTICE.md). -->
  <ItemGroup>
    <ProjectReference Include="..\third_party\ScamWYF.Setup.Core\ScamWYF.Setup.Core.csproj" />
  </ItemGroup>

  <!-- Mono.Cecil reads and writes assemblies through reflection-heavy code; keep the trimmer away from it. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Mono.Cecil" />
    <TrimmerRootAssembly Include="ScamWYF.Setup.Core" />
  </ItemGroup>

  <!-- Release builds embed the payload so the .exe is all a player needs. -->
  <ItemGroup>
    <!-- Wildcards so a dev build without a payload folder still compiles. -->
    <EmbeddedResource Include="payload\*.zip;payload\*.txt" LogicalName="payload/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
